# Smart Grid System - Environment Configuration Template
# Copy this file to .env and fill in the actual values

# ======================== BACKEND CONFIGURATION ========================

# FastAPI Server
FASTAPI_HOST=0.0.0.0
FASTAPI_PORT=8000
FASTAPI_DEBUG=false

# Database
DATABASE_URL=sqlite:///./smart_grid.db

# CORS
CORS_ORIGINS=["http://localhost:5173", "http://localhost:3000"]

# ======================== BLOCKCHAIN CONFIGURATION ========================

# Hardhat / Ethereum Node
HARDHAT_RPC_URL=http://127.0.0.1:8545
CONTRACT_ADDRESS=0x...  # Will be set after deployment
PRIVATE_KEY=0x...       # Deployer private key (from Hardhat accounts)

# ======================== HARDWARE CONFIGURATION ========================

# ESP32 WiFi
WIFI_SSID=YOUR_NETWORK_SSID
WIFI_PASSWORD=YOUR_NETWORK_PASSWORD

# Backend API Endpoint (for ESP32)
BACKEND_API_URL=http://192.168.1.100:8000/api/telemetry

# ======================== ML ENGINE CONFIGURATION ========================

# Anomaly Detection
ISOLATION_FOREST_CONTAMINATION=0.05
ANOMALY_BUFFER_SIZE=100
ANOMALY_DETECTION_ENABLED=true

# Forecasting
CONSUMPTION_FORECAST_HOURS=24
FORECAST_ENABLED=true

# ======================== MONITORING & LOGGING ========================

LOG_LEVEL=INFO
LOG_FILE=smart_grid.log

# ======================== OPTIONAL: PRODUCTION SETTINGS ========================

# AWS / Cloud Deployment (if applicable)
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=us-east-1

# Email Alerts
# SMTP_SERVER=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# ALERT_EMAIL=admin@example.com
