        ]
    },
    {
        "id": "ui_map",
        "type": "ui-template",
        "z": "b471cefc9ae886a6",
        "group": "grp_map",
        "name": "Compact Flow Map",
        "order": 1,
        "width": "12",
        "height": "4",
        "format": "<template>\n  <div v-if=\"msg?.payload?.h1\" style=\"background:#1e1e1e; padding:10px; border-radius:8px; color:white; text-align:center; font-family:sans-serif; height: 100%; box-sizing: border-box;\">\n    <div style=\"font-weight:bold; font-size:16px; margin-bottom:10px;\">⚡ Central Grid Substation</div>\n    <div style=\"display:flex; justify-content:space-around;\">\n      <div v-for=\"(house, key) in msg.payload\" :key=\"key\" style=\"width:30%;\">\n        <div :class=\"house.b > 0 ? 'f-active' : 'f-cut'\" style=\"height:15px; margin-bottom:5px;\"></div>\n        <div style=\"border: 1px solid #444; border-radius: 6px; padding: 5px; background:#2a2a2a;\">\n          <div style=\"font-weight:bold; text-transform:uppercase; font-size:14px; margin-bottom:5px;\">🏠 {{key}}</div>\n          <div style=\"display:flex; justify-content:space-around; font-size:11px;\">\n            <div>\n              <div :class=\"(house.b > 0 && house.f) ? 'f-active' : 'f-cut'\" style=\"height:15px; margin-bottom:2px;\"></div>\n              <span :class=\"(house.b > 0 && house.f) ? 'on':'off'\">{{ (house.b > 0 && house.f) ? 'FAN (2u/s)' : 'FAN OFF' }}</span>\n            </div>\n            <div>\n              <div :class=\"(house.b > 0 && house.l) ? 'f-active' : 'f-cut'\" style=\"height:15px; margin-bottom:2px;\"></div>\n              <span :class=\"(house.b > 0 && house.l) ? 'on':'off'\">{{ (house.b > 0 && house.l) ? 'LIGHT (1u/s)' : 'LIGHT OFF' }}</span>\n            </div>\n          </div>\n        </div>\n      </div>\n    </div>\n  </div>\n  <div v-else style=\"padding: 10px; color: white; background:#1e1e1e;\">⏳ Connecting...</div>\n</template>\n<style>\n  .f-active { width:4px; background: repeating-linear-gradient(to bottom, #2ECC71, #2ECC71 8px, transparent 8px, transparent 16px); background-size: 100% 16px; animation: flowAnim 0.8s linear infinite; margin: 0 auto; }\n  .f-cut { width:4px; background: #444; margin: 0 auto; }\n  @keyframes flowAnim { 0% { background-position: 0 0; } 100% { background-position: 0 16px; } }\n  .on { color: #2ECC71; font-weight:bold; } .off { color: #E74C3C; font-weight:bold; }\n</style>",
        "storeOutMessages": true,
        "templateScope": "local",
        "x": 670,
        "y": 140,
        "wires": [
            []
        ]
