    {
        "id": "engine",
        "type": "function",
        "z": "b471cefc9ae886a6",
        "name": "Physics Engine",
        "func": "let s = flow.get('grid_state') || {h1:{b:0,f:false,l:false}, h2:{b:0,f:false,l:false}, h3:{b:0,f:false,l:false}};\nif (msg.topic === 'buy1') s.h1.b += 50;\nif (msg.topic === 'buy2') s.h2.b += 50;\nif (msg.topic === 'buy3') s.h3.b += 50;\nif (msg.topic === 'f1') s.h1.f = msg.payload;\nif (msg.topic === 'l1') s.h1.l = msg.payload;\nif (msg.topic === 'f2') s.h2.f = msg.payload;\nif (msg.topic === 'l2') s.h2.l = msg.payload;\nif (msg.topic === 'f3') s.h3.f = msg.payload;\nif (msg.topic === 'l3') s.h3.l = msg.payload;\nif (msg.topic === 'tick') {\n    ['h1','h2','h3'].forEach(h => {\n        if (s[h].b > 0) {\n            let drain = 0;\n            if (s[h].f) drain += 2;\n            if (s[h].l) drain += 1;\n            s[h].b -= drain;\n        }\n        if (s[h].b <= 0) {\n            s[h].b = 0;\n            s[h].f = false;\n            s[h].l = false;\n        }\n    });\n}\nflow.set('grid_state', s);\nreturn [{payload: s}, {payload: s.h1.b}, {payload: s.h2.b}, {payload: s.h3.b}, {payload: s.h1.f}, {payload: s.h1.l}, {payload: s.h2.f}, {payload: s.h2.l}, {payload: s.h3.f}, {payload: s.h3.l}];",
        "outputs": 10,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 420,
        "y": 280,
        "wires": [
            [
                "ui_map"
            ],
            [
                "g_h1"
            ],
            [
                "g_h2"
            ],
            [
                "g_h3"
            ],
